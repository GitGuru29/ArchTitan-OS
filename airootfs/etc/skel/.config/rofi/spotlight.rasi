/* ============================================================
 * ArchTitan OS — Raycast-style Spotlight Search Theme for Rofi
 * Modern frosted obsidian glass card with crisp typography
 * ============================================================ */

* {
    bg-card:        #E80B0E14;
    bg-input:       rgba(255, 255, 255, 0.05);
    bg-selected:    rgba(122, 162, 247, 0.18);
    bg-hover:       rgba(255, 255, 255, 0.04);
    border-accent:  rgba(122, 162, 247, 0.45);
    border-subtle:  rgba(255, 255, 255, 0.08);
    text-primary:   #E2E8F0;
    text-secondary: #94A3B8;
    text-accent:    #7AA2F7;
    text-dim:       #64748B;
    scrollbar-clr:  rgba(122, 162, 247, 0.4);

    background-color: transparent;
    text-color:       #E2E8F0;
    font:             "Inter, sans-serif 12";
    border:           0px;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

/* ── Root Window ───────────────────────────────────────────── */
window {
    location:         center;
    anchor:           center;
    width:            660px;
    border-radius:    20px;
    background-color: #E80B0E14;
    border:           1px;
    border-color:     rgba(122, 162, 247, 0.35);
}

/* ── Main Layout ────────────────────────────────────────────── */
mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview, mode-switcher ];
    padding:          16px;
    spacing:          12px;
}

/* ── Search Input Field ─────────────────────────────────────── */
inputbar {
    background-color: rgba(255, 255, 255, 0.045);
    border-radius:    14px;
    border:           1px;
    border-color:     rgba(255, 255, 255, 0.08);
    padding:          12px 16px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       #7AA2F7;
    font:             "JetBrainsMono Nerd Font 14";
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        #E2E8F0;
    placeholder-color: #64748B;
    placeholder:       "Search applications, files, commands...";
    font:              "Inter 13";
    cursor:            text;
    vertical-align:    0.5;
}

/* ── Message (e.g. error or info) ───────────────────────────── */
message {
    background-color: transparent;
    padding:          6px 12px;
}

textbox {
    text-color:       #94A3B8;
    font:             "Inter 11";
    background-color: transparent;
}

/* ── Results List ───────────────────────────────────────────── */
listview {
    background-color: transparent;
    padding:          4px 0px;
    spacing:          4px;
    lines:            7;
    columns:          1;
    scrollbar:        true;
    fixed-height:     false;
    dynamic:          true;
    cycle:            false;
}

/* ── Result Row Element ─────────────────────────────────────── */
element {
    background-color: transparent;
    padding:          10px 14px;
    border-radius:    12px;
    spacing:          14px;
    orientation:      horizontal;
    children:         [ element-icon, element-text ];
    cursor:           pointer;
    border:           1px;
    border-color:     transparent;
}

element-icon {
    size:             34px;
    background-color: transparent;
    vertical-align:   0.5;
    cursor:           pointer;
}

element-text {
    background-color: transparent;
    text-color:       #E2E8F0;
    font:             "Inter 12.5";
    vertical-align:   0.5;
    cursor:           pointer;
    highlight:        bold #7AA2F7;
}

/* Selected Element */
element.selected.normal,
element.selected.urgent,
element.selected.active {
    background-color: rgba(122, 162, 247, 0.18);
    border:           1px;
    border-color:     rgba(122, 162, 247, 0.50);
}

element.selected.normal element-text,
element.selected.urgent element-text,
element.selected.active element-text {
    text-color: #FFFFFF;
}

/* ── Scrollbar ──────────────────────────────────────────────── */
scrollbar {
    width:            4px;
    handle-width:     4px;
    handle-color:     rgba(122, 162, 247, 0.4);
    background-color: transparent;
    border-radius:    4px;
    margin:           0px 0px 0px 6px;
}

/* ── Mode Switcher & Footer ─────────────────────────────────── */
mode-switcher {
    background-color: transparent;
    border:           1px 0px 0px 0px;
    border-color:     rgba(255, 255, 255, 0.08);
    padding:          10px 6px 2px 6px;
    spacing:          8px;
}

button {
    background-color: transparent;
    text-color:       #64748B;
    font:             "Inter 10.5";
    padding:          5px 12px;
    border-radius:    8px;
    cursor:           pointer;
}

button.selected {
    background-color: rgba(122, 162, 247, 0.2);
    text-color:       #7AA2F7;
}
