/* ============================================================
 * ArchTitan OS — Raycast-style Spotlight Search Theme for Rofi
 * Catppuccin Mocha frosted obsidian glass card, crisp typography
 * ============================================================ */

* {
/* titan-theme:begin */
    /* generated by `titan-theme` — do not edit by hand */
    bg-card:        #11111BE8;
    bg-input:       rgba(255, 255, 255, 0.05);
    bg-selected:    rgba(137, 180, 250, 0.18);
    bg-hover:       rgba(255, 255, 255, 0.04);
    border-accent:  rgba(137, 180, 250, 0.45);
    border-subtle:  rgba(255, 255, 255, 0.08);
    text-primary:   #CDD6F4;
    text-secondary: #A6ADC8;
    text-accent:    #89B4FA;
    text-dim:       #6C7086;
    text-highlight: bold #89B4FA;
    text-selected:  #FFFFFF;
    scrollbar-clr:  rgba(137, 180, 250, 0.40);
/* titan-theme:end */

    background-color: transparent;
    text-color:       @text-primary;
    font:             "Inter, sans-serif 12";
    border:           0px;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

/* ── Root Window ───────────────────────────────────────────── */
window {
    location:         center;
    anchor:           center;
    width:            660px;
    border-radius:    20px;
    background-color: @bg-card;
    border:           1px;
    border-color:     @border-accent;
}

/* ── Main Layout ────────────────────────────────────────────── */
mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview, mode-switcher ];
    padding:          16px;
    spacing:          12px;
}

/* ── Search Input Field ─────────────────────────────────────── */
inputbar {
    background-color: @bg-input;
    border-radius:    14px;
    border:           1px;
    border-color:     @border-subtle;
    padding:          12px 16px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @text-accent;
    font:             "JetBrainsMono Nerd Font 14";
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        @text-primary;
    placeholder-color: @text-dim;
    placeholder:       "Search applications, files, commands...";
    font:              "Inter 13";
    cursor:            text;
    vertical-align:    0.5;
}

/* ── Message (e.g. error or info) ───────────────────────────── */
message {
    background-color: transparent;
    padding:          6px 12px;
}

textbox {
    text-color:       @text-secondary;
    font:             "Inter 11";
    background-color: transparent;
}

/* ── Results List ───────────────────────────────────────────── */
listview {
    background-color: transparent;
    padding:          4px 0px;
    spacing:          4px;
    lines:            7;
    columns:          1;
    scrollbar:        true;
    fixed-height:     false;
    dynamic:          true;
    cycle:            false;
}

/* ── Result Row Element ─────────────────────────────────────── */
element {
    background-color: transparent;
    padding:          10px 14px;
    border-radius:    12px;
    spacing:          14px;
    orientation:      horizontal;
    children:         [ element-icon, element-text ];
    cursor:           pointer;
    border:           1px;
    border-color:     transparent;
}

element-icon {
    size:             34px;
    background-color: transparent;
    vertical-align:   0.5;
    cursor:           pointer;
}

element-text {
    background-color: transparent;
    text-color:       @text-primary;
    font:             "Inter 12.5";
    vertical-align:   0.5;
    cursor:           pointer;
    highlight:        @text-highlight;
}

/* Selected Element */
element.selected.normal,
element.selected.urgent,
element.selected.active {
    background-color: @bg-selected;
    border:           1px;
    border-color:     @border-accent;
}

element.selected.normal element-text,
element.selected.urgent element-text,
element.selected.active element-text {
    text-color: @text-selected;
}

/* ── Scrollbar ──────────────────────────────────────────────── */
scrollbar {
    width:            4px;
    handle-width:     4px;
    handle-color:     @scrollbar-clr;
    background-color: transparent;
    border-radius:    4px;
    margin:           0px 0px 0px 6px;
}

/* ── Mode Switcher & Footer ─────────────────────────────────── */
mode-switcher {
    background-color: transparent;
    border:           1px 0px 0px 0px;
    border-color:     @border-subtle;
    padding:          10px 6px 2px 6px;
    spacing:          8px;
}

button {
    background-color: transparent;
    text-color:       @text-dim;
    font:             "Inter 10.5";
    padding:          5px 12px;
    border-radius:    8px;
    cursor:           pointer;
}

button.selected {
    background-color: @bg-selected;
    text-color:       @text-accent;
}
