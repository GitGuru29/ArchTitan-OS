# ArchTitan OS — "Rise, Titan." First-Boot Ceremony
# Prototype-accurate sequence:
#   logo intro -> dots rise into a line -> the line curls into a circle ->
#   smooth eased 360° orbit -> settle -> each dot falls to its slot and morphs
#   into its colored character -> hold -> fade out (auto, or any key/click).
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
center_x = screen_width / 2.0;
center_y = screen_height / 2.0;

# ── Background: radial blue/violet glows over near-black ──
bg_sprite = Sprite(Image("assets/bg.png").Scale(screen_width, screen_height));
bg_sprite.SetX(0);
bg_sprite.SetY(0);
bg_sprite.SetZ(0);

# ── Typography (uniform scale + true typographic baseline) ──
font = screen_width * 0.06;
if (font < 48) font = 48;
if (font > 86) font = 86;

scale = font / 220.0;
gap = 0.06 * font;
space_gap = 0.32 * font;   # word space after comma (i == 4)

# Measured ink widths of the source glyphs (visible letterforms, px)
ink_w[0] = 206; ink_w[1] = 60; ink_w[2] = 150; ink_w[3] = 182; ink_w[4] = 70;
ink_w[5] = 195; ink_w[6] = 60; ink_w[7] = 138; ink_w[8] = 177; ink_w[9] = 183;

# Source canvas widths (letters/i are 400 wide, comma 180 wide)
canvas_w[0] = 400; canvas_w[1] = 400; canvas_w[2] = 400; canvas_w[3] = 400; canvas_w[4] = 180;
canvas_w[5] = 400; canvas_w[6] = 400; canvas_w[7] = 400; canvas_w[8] = 400; canvas_w[9] = 400;

# Exact baseline Y offset inside each 512px source canvas so all letters sit flat on one baseline
ink_bottom[0] = 384; ink_bottom[1] = 393; ink_bottom[2] = 355; ink_bottom[3] = 355; ink_bottom[4] = 265;
ink_bottom[5] = 385; ink_bottom[6] = 393; ink_bottom[7] = 375; ink_bottom[8] = 355; ink_bottom[9] = 356;

# Pre-coloured per-slot glyphs
glyph_files[0] = "assets/glyph_c0.png";
glyph_files[1] = "assets/glyph_c1.png";
glyph_files[2] = "assets/glyph_c2.png";
glyph_files[3] = "assets/glyph_c3.png";
glyph_files[4] = "assets/glyph_c4.png";
glyph_files[5] = "assets/glyph_c5.png";
glyph_files[6] = "assets/glyph_c6.png";
glyph_files[7] = "assets/glyph_c7.png";
glyph_files[8] = "assets/glyph_c8.png";
glyph_files[9] = "assets/glyph_c9.png";

# Phrase width, then centred slot centres
total = 0.0;
for (i = 0; i < 10; i++) {
    total = total + ink_w[i] * scale;
    if (i < 9) {
        if (i == 4) total = total + space_gap;
        else total = total + gap;
    }
}

cursor = center_x - total / 2.0;
for (i = 0; i < 10; i++) {
    slot_w = ink_w[i] * scale;
    slot_x[i] = cursor + slot_w / 2.0;
    cursor = cursor + slot_w;
    if (i < 9) {
        if (i == 4) cursor = cursor + space_gap;
        else cursor = cursor + gap;
    }
}
slot_y = center_y + Math.Min(150.0, screen_height * 0.145);

# The 10 coloured characters, anchored on their slots and aligned to slot_y baseline
for (i = 0; i < 10; i++) {
    glyph_w = canvas_w[i] * scale;
    char_x[i] = slot_x[i] - glyph_w / 2.0;
    glyph_h[i] = 512 * scale;
    char_y[i] = slot_y - ink_bottom[i] * scale;
    chars[i] = Sprite(Image(glyph_files[i]).Scale(glyph_w, glyph_h[i]));
    chars[i].SetX(char_x[i]);
    chars[i].SetY(char_y[i]);
    chars[i].SetZ(2);
    chars[i].SetOpacity(0.0);
}

# ── Chromatic precision dots matching each letter's exact color ──
dot_d = Math.Max(12.0, Math.Min(screen_width, screen_height) * 0.018);

line_gap = 32.0;
if (screen_width * 0.028 < line_gap) line_gap = screen_width * 0.028;

radius = Math.Min(screen_width, screen_height) * 0.095;
circle_cy = center_y - 20.0;

for (i = 0; i < 10; i++) {
    dots[i] = Sprite(Image("assets/dot_c" + i + ".png").Scale(dot_d, dot_d));
    dots[i].SetZ(4);
    dots[i].SetOpacity(0.0);
    base_a[i] = -1.5707963267948966 + i * 0.6283185307179586;   # -90° + i*36°
}

# ── ArchTitan logo intro ──
logo_image = Image("assets/logo.png");
logo_ratio = logo_image.GetWidth() / logo_image.GetHeight();
if (screen_width / screen_height > logo_ratio) {
    logo_scale = (screen_height / logo_image.GetHeight()) * 0.35;
} else {
    logo_scale = (screen_width / logo_image.GetWidth()) * 0.35;
}
logo_w = logo_image.GetWidth() * logo_scale;
logo_h = logo_image.GetHeight() * logo_scale;
logo_sprite = Sprite(logo_image.Scale(logo_w, logo_h));
logo_sprite.SetX(center_x - logo_w / 2.0);
logo_sprite.SetY(center_y - logo_h / 2.0);
logo_sprite.SetZ(10);
logo_sprite.SetOpacity(0.0);

# ── Timeline (frames, ~50fps) ──
frame = 0;
user_clicked = 0;
fade_out_frame = 0;

logo_total = 70;
logo_fade_in = 20;
logo_fade_out_start = 50;

line_t = 24;      # dots rise into the line
circle_t = 24;    # line curls into the circle
orbit_t = 60;     # smooth eased 360° rotation
settle_t = 8;     # pause before drops
base = line_t + circle_t + orbit_t + settle_t;
step = 7;         # stagger between successive drops
drop_t = 20;      # per-dot fall duration
drop_end = base + 9 * step + drop_t;
hold_t = 70;      # hold on finished phrase (~1.4s)
auto_end = drop_end + hold_t;
two_pi = 6.283185307179586;

# ── Helpers ──
fun clamp01(t) {
    if (t < 0.0) t = 0.0;
    if (t > 1.0) t = 1.0;
    return t;
}
fun ease_out(t) {
    t = clamp01(t);
    u = 1.0 - t;
    return 1.0 - u * u * u;
}
fun ease_inout(t) {
    t = clamp01(t);
    if (t < 0.5) return 4.0 * t * t * t;
    u = -2.0 * t + 2.0;
    return 1.0 - (u * u * u) / 2.0;
}
fun lerp(a, b, t) {
    return a + (b - a) * t;
}

fun refresh_callback() {
    frame++;
    i = 0;
    q = 0.0;

    # Phase 0: ArchTitan logo intro
    if (frame <= logo_total) {
        if (frame <= logo_fade_in) {
            logo_opacity = frame / logo_fade_in;
        } else if (frame >= logo_fade_out_start) {
            fade_progress = (frame - logo_fade_out_start) / (logo_total - logo_fade_out_start);
            logo_opacity = 1.0 - fade_progress;
        } else {
            logo_opacity = 1.0;
        }
        if (logo_opacity > 1.0) logo_opacity = 1.0;
        if (logo_opacity < 0.0) logo_opacity = 0.0;
        logo_sprite.SetOpacity(logo_opacity);
        return;
    }

    t = frame - logo_total;

    # Skip / Exit: smooth fade out to SDDM
    if (user_clicked == 1) {
        fade_out_frame++;
        alpha = 1.0 - fade_out_frame / 20.0;
        if (alpha < 0.0) alpha = 0.0;
        for (i = 0; i < 10; i++) {
            dots[i].SetOpacity(alpha);
            chars[i].SetOpacity(alpha);
        }
        bg_sprite.SetOpacity(alpha);
        if (fade_out_frame >= 20) {
            Plymouth.Quit();
        }
        return;
    }

    # Phase 1: chromatic dots rise smoothly into a horizontal line
    if (t < line_t) {
        for (i = 0; i < 10; i++) {
            stagger = i * 1.5;
            if (t > stagger) {
                q = ease_out((t - stagger) / (line_t - stagger));
            } else {
                q = 0.0;
            }
            dots[i].SetX(center_x - line_gap * 4.5 + i * line_gap - dot_d / 2.0);
            dots[i].SetY(lerp(center_y + 16.0, center_y - dot_d / 2.0, q));
            dots[i].SetOpacity(q);
        }
        return;
    }

    # Phase 2: the line curls smoothly into a chromatic circle
    if (t < line_t + circle_t) {
        q = ease_inout((t - line_t) / circle_t);
        for (i = 0; i < 10; i++) {
            line_x = center_x - line_gap * 4.5 + i * line_gap - dot_d / 2.0;
            circ_x = center_x + Math.Cos(base_a[i]) * radius - dot_d / 2.0;
            circ_y = circle_cy + Math.Sin(base_a[i]) * radius - dot_d / 2.0;
            dots[i].SetX(lerp(line_x, circ_x, q));
            dots[i].SetY(lerp(center_y - dot_d / 2.0, circ_y, q));
            dots[i].SetOpacity(1.0);
        }
        return;
    }

    # Phase 3: smooth, high-tech 360° orbit
    if (t < line_t + circle_t + orbit_t) {
        q = ease_inout((t - line_t - circle_t) / orbit_t);
        rot = q * two_pi;
        for (i = 0; i < 10; i++) {
            angle = base_a[i] + rot;
            dots[i].SetX(center_x + Math.Cos(angle) * radius - dot_d / 2.0);
            dots[i].SetY(circle_cy + Math.Sin(angle) * radius - dot_d / 2.0);
            dots[i].SetOpacity(1.0);
        }
        return;
    }

    # Phase 4: settle on the circle
    if (t < base) {
        for (i = 0; i < 10; i++) {
            angle = base_a[i] + two_pi;
            dots[i].SetX(center_x + Math.Cos(angle) * radius - dot_d / 2.0);
            dots[i].SetY(circle_cy + Math.Sin(angle) * radius - dot_d / 2.0);
            dots[i].SetOpacity(1.0);
        }
        return;
    }

    # Phase 5: smooth, non-bouncy descent into "Rise, Titan"
    if (t < drop_end) {
        for (i = 0; i < 10; i++) {
            start_t = base + i * step;
            circ_x = center_x + Math.Cos(base_a[i] + two_pi) * radius - dot_d / 2.0;
            circ_y = circle_cy + Math.Sin(base_a[i] + two_pi) * radius - dot_d / 2.0;
            dest_x = slot_x[i] - dot_d / 2.0;
            dest_y = slot_y - (ink_bottom[i] * 0.5) * scale - dot_d / 2.0;

            if (t < start_t) {
                dots[i].SetX(circ_x);
                dots[i].SetY(circ_y);
                dots[i].SetOpacity(1.0);
                chars[i].SetOpacity(0.0);
            } else {
                lt = (t - start_t) / drop_t;
                if (lt > 1.0) lt = 1.0;
                q = ease_out(lt);
                x = lerp(circ_x, dest_x, q);
                y = lerp(circ_y, dest_y, q);
                dots[i].SetX(x);
                dots[i].SetY(y);

                # Smooth direct cross-fade from dot to glyph during landing
                dot_phase = (lt - 0.40) / 0.60;
                if (dot_phase < 0.0) dot_phase = 0.0;
                if (dot_phase > 1.0) dot_phase = 1.0;

                dots[i].SetOpacity(1.0 - dot_phase);
                chars[i].SetX(char_x[i]);
                chars[i].SetY(char_y[i]);
                chars[i].SetOpacity(dot_phase);
            }
        }
        return;
    }

    # Phase 6: hold the complete phrase "Rise, Titan", then auto-advance
    for (i = 0; i < 10; i++) {
        dots[i].SetOpacity(0.0);
        chars[i].SetX(char_x[i]);
        chars[i].SetY(char_y[i]);
        chars[i].SetOpacity(1.0);
    }
    if (t >= auto_end) {
        user_clicked = 1;
    }
}

fun click_or_key_handler() {
    if (frame > logo_total && user_clicked == 0) {
        user_clicked = 1;
        fade_out_frame = 0;
    }
}

fun key_press_callback(text, key) {
    click_or_key_handler();
}

fun quit_callback() {
    user_clicked = 1;
    fade_out_frame = 20;
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetKeyboardInputFunction(key_press_callback);
Plymouth.SetQuitFunction(quit_callback);
