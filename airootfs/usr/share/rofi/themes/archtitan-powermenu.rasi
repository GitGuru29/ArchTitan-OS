* {
    bg-base:      #11111ba6; /* Deep dark translucent background */
    bg-element:   #18182599; /* Glass effect for buttons */
    bg-hover:     rgba(137, 180, 250, 0.22); /* Soft blue glow on hover */
    border-subtle: rgba(255, 255, 255, 0.08);
    text-normal:  #a6adc8;
    text-accent:  #89b4fa;
    text-selected: #ffffff;
    
    background-color: transparent;
    text-color:       @text-normal;
    font:             "JetBrainsMono Nerd Font 24";
}

window {
    fullscreen: true;
    background-color: @bg-base;
    padding: 30% 16%; /* Centers the grid vertically */
}

mainbox {
    background-color: transparent;
    children: [ listview ];
}

listview {
    background-color: transparent;
    layout: horizontal;
    spacing: 32px;
    lines: 5;
    align: center;
}

element {
    background-color: @bg-element;
    padding: 52px 36px;
    border-radius: 24px;
    border: 1px;
    border-color: @border-subtle;
    orientation: vertical;
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: @bg-element;
    text-color:       @text-normal;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    cursor: inherit;
}

element selected.normal,
element selected.urgent,
element selected.active {
    background-color: @bg-hover;
    border: 1px;
    border-color: @text-accent;
    text-color: @text-selected;
}
