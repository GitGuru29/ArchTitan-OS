#!/usr/bin/env python3
"""
ArchTitan OS — Mission Control Workspace Grid HUD (titan-workspace-hud)
Reveals an interactive 2x5 workspace overview grid when the Super key is held
for >= 280ms. Provides live window preview tiles, application icons, click-to-switch,
close window buttons, direct keyboard shortcut badges, and drag-and-drop window relocation.
"""

import sys
import os
import json
import subprocess
import signal
import time
import gi

gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('GtkLayerShell', '0.1')
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib, GtkLayerShell

PID_FILE = f"/tmp/titan-ws-hud-{os.getuid()}.pid"

def cmd_hold():
    if os.path.exists(PID_FILE):
        return

    pid = os.fork()
    if pid > 0:
        return

    os.setsid()
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    try:
        # Hold threshold: 280ms. Quick taps / shortcuts exit before this fires.
        time.sleep(0.28)
        if not os.path.exists(PID_FILE):
            return

        run_gui()
    finally:
        if os.path.exists(PID_FILE):
            try:
                os.remove(PID_FILE)
            except OSError:
                pass

def cmd_release():
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.remove(PID_FILE)
            os.kill(pid, signal.SIGTERM)
        except Exception:
            pass

def get_hyprland_state():
    try:
        workspaces_out = subprocess.check_output(["hyprctl", "workspaces", "-j"], timeout=1)
        clients_out = subprocess.check_output(["hyprctl", "clients", "-j"], timeout=1)
        monitors_out = subprocess.check_output(["hyprctl", "monitors", "-j"], timeout=1)

        workspaces = json.loads(workspaces_out.decode("utf-8"))
        clients = json.loads(clients_out.decode("utf-8"))
        monitors = json.loads(monitors_out.decode("utf-8"))

        active_ws_id = 1
        mon_w = 1920
        mon_h = 1080
        for m in monitors:
            if m.get("focused"):
                active_ws_id = m.get("activeWorkspace", {}).get("id", 1)
                mon_w = m.get("width", 1920)
                mon_h = m.get("height", 1080)
                break

        ws_windows = {}
        for c in clients:
            ws_id = c.get("workspace", {}).get("id")
            if ws_id and 1 <= ws_id <= 10:
                ws_windows.setdefault(ws_id, []).append({
                    "address": c.get("address", ""),
                    "class": c.get("class", ""),
                    "title": c.get("title", ""),
                    "at": c.get("at", [0, 0]),
                    "size": c.get("size", [100, 100]),
                    "floating": c.get("floating", False)
                })

        return active_ws_id, ws_windows, mon_w, mon_h
    except Exception:
        return 1, {}, 1920, 1080

def load_app_pixbuf(app_class, size=40):
    icon_theme = Gtk.IconTheme.get_default()
    name = app_class.lower()
    candidates = [
        name,
        name.replace('-ide', ''),
        name.replace('org.kde.', ''),
        name.replace('google-', ''),
        name.split('-')[0],
        name.split('.')[ -1] if '.' in name else name
    ]
    if "chrome" in name: candidates.insert(0, "google-chrome")
    if "antigravity" in name: candidates.insert(0, "antigravity-ide")
    if "kitty" in name: candidates.insert(0, "kitty")
    if "dolphin" in name: candidates.insert(0, "org.kde.dolphin")
    if "code" in name: candidates.insert(0, "code")
    if "firefox" in name: candidates.insert(0, "firefox")

    for cand in candidates:
        if icon_theme.has_icon(cand):
            try:
                return icon_theme.load_icon(cand, size, Gtk.IconLookupFlags.FORCE_SIZE)
            except Exception:
                pass
        for p in [
            f"/usr/share/pixmaps/{cand}.png",
            f"/usr/share/pixmaps/{cand}.svg",
            f"/usr/share/icons/hicolor/48x48/apps/{cand}.png",
            f"/usr/share/icons/hicolor/scalable/apps/{cand}.svg",
            f"/usr/share/icons/breeze-dark/apps/48/{cand}.svg"
        ]:
            if os.path.exists(p):
                try:
                    return GdkPixbuf.Pixbuf.new_from_file_at_scale(p, size, size, True)
                except Exception:
                    pass

    try:
        return icon_theme.load_icon("application-x-executable", size, Gtk.IconLookupFlags.FORCE_SIZE)
    except Exception:
        return None

class WorkspaceGridHUD(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.set_title("titan-workspace-hud")

        # Layer Shell configuration
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_namespace(self, "titan-workspace-hud")
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 110)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)

        # Scaled-up card dimensions (16:9 proportional)
        self.card_w = 236
        self.card_h = 136
        self.is_dragging = False
        self.pending_dismiss = False

        self.connect("key-press-event", self.on_key_press)
        self.setup_css()
        self.build_ui()

    def setup_css(self):
        css = b"""
        window {
            background: transparent;
        }
        .overview-container {
            background: rgba(18, 19, 28, 0.94);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 24px;
            padding: 18px;
            box-shadow: 0 28px 70px rgba(0, 0, 0, 0.80);
        }
        .workspace-card {
            background: rgba(30, 31, 46, 0.55);
            border: 1.5px solid rgba(255, 255, 255, 0.07);
            border-radius: 16px;
            transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .workspace-card:hover {
            background: rgba(38, 40, 58, 0.70);
            border-color: rgba(255, 255, 255, 0.16);
        }
        .workspace-card.active {
            background: rgba(24, 26, 42, 0.85);
            border: 2px solid #00D2FF;
            box-shadow: 0 0 24px rgba(0, 210, 255, 0.40);
        }
        .workspace-card.drag-hover {
            background: rgba(0, 210, 255, 0.18);
            border: 2px dashed #00D2FF;
            box-shadow: 0 0 28px rgba(0, 210, 255, 0.60);
        }
        .workspace-empty-num {
            color: rgba(205, 214, 244, 0.22);
            font-family: 'Inter', 'Noto Sans', sans-serif;
            font-size: 52px;
            font-weight: 700;
        }
        .workspace-card.active .workspace-empty-num {
            color: rgba(0, 210, 255, 0.55);
        }
        .workspace-shortcut-badge {
            background: rgba(17, 17, 27, 0.75);
            border: 1px solid rgba(255, 255, 255, 0.10);
            border-radius: 6px;
            padding: 1px 6px;
            font-family: 'JetBrainsMono Nerd Font', monospace;
            font-size: 10px;
            font-weight: 700;
            color: rgba(205, 214, 244, 0.50);
        }
        .workspace-card.active .workspace-shortcut-badge {
            background: rgba(0, 210, 255, 0.18);
            border-color: rgba(0, 210, 255, 0.50);
            color: #00D2FF;
        }
        .workspace-count-badge {
            background: rgba(17, 17, 27, 0.80);
            border: 1px solid rgba(255, 255, 255, 0.10);
            border-radius: 6px;
            padding: 1px 6px;
            font-family: 'Inter', sans-serif;
            font-size: 9px;
            font-weight: 600;
            color: rgba(205, 214, 244, 0.65);
        }
        .window-tile {
            background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.025) 0px, rgba(255, 255, 255, 0.025) 2px, transparent 2px, transparent 6px), rgba(24, 25, 38, 0.94);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.45);
            transition: background 0.12s ease, border-color 0.12s ease;
        }
        .window-tile:hover {
            background: repeating-linear-gradient(0deg, rgba(0, 210, 255, 0.05) 0px, rgba(0, 210, 255, 0.05) 2px, transparent 2px, transparent 6px), rgba(36, 38, 56, 0.98);
            border-color: rgba(0, 210, 255, 0.70);
            box-shadow: 0 0 14px rgba(0, 210, 255, 0.35);
        }
        .tile-close-btn {
            background: rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            transition: all 0.15s ease;
        }
        .tile-close-btn:hover {
            background: #F38BA8;
        }
        .tile-close-lbl {
            color: rgba(205, 214, 244, 0.60);
            font-size: 9px;
            font-weight: 700;
        }
        .tile-close-btn:hover .tile-close-lbl {
            color: #11111B;
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def build_ui(self):
        active_ws, ws_windows, mon_w, mon_h = get_hyprland_state()

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        main_box.get_style_context().add_class("overview-container")

        # 2x5 Grid
        grid = Gtk.Grid()
        grid.set_column_spacing(12)
        grid.set_row_spacing(12)

        # Targets for DND
        dnd_targets = [Gtk.TargetEntry.new("text/plain", Gtk.TargetFlags.SAME_APP, 0)]

        for ws_id in range(1, 11):
            col = (ws_id - 1) % 5
            row = (ws_id - 1) // 5

            card_event = Gtk.EventBox()
            card_event.set_size_request(self.card_w, self.card_h)
            card_event.get_style_context().add_class("workspace-card")
            if ws_id == active_ws:
                card_event.get_style_context().add_class("active")

            # Setup card as DND drop destination
            card_event.drag_dest_set(Gtk.DestDefaults.ALL, dnd_targets, Gdk.DragAction.MOVE)
            card_event.connect("drag-data-received", self.on_drag_data_received, ws_id)
            card_event.connect("drag-motion", self.on_drag_motion)
            card_event.connect("drag-leave", self.on_drag_leave)
            card_event.connect("button-press-event", self.on_card_clicked, ws_id)

            fixed = Gtk.Fixed()
            fixed.set_size_request(self.card_w, self.card_h)

            windows = ws_windows.get(ws_id, [])
            if windows:
                usable_w = self.card_w - 16
                usable_h = self.card_h - 16
                offset_x = 8
                offset_y = 8

                num_wins = len(windows)
                for idx, win in enumerate(windows):
                    wx, wy = win["at"]
                    ww, wh = win["size"]

                    if num_wins <= 4:
                        # Scale proportionally to monitor dimensions
                        rx = int((wx / mon_w) * usable_w) + offset_x
                        ry = int((wy / mon_h) * usable_h) + offset_y
                        rw = max(48, int((ww / mon_w) * usable_w))
                        rh = max(48, int((wh / mon_h) * usable_h))
                    else:
                        # Clean mini 2x2 grid for busy workspaces (5+ windows)
                        sub_col = idx % 2
                        sub_row = (idx // 2) % 2
                        rw = (usable_w - 6) // 2
                        rh = (usable_h - 6) // 2
                        rx = offset_x + sub_col * (rw + 6)
                        ry = offset_y + sub_row * (rh + 6)
                        if idx >= 4:
                            break

                    # Ensure tile stays inside the card
                    rx = max(6, min(rx, self.card_w - rw - 6))
                    ry = max(6, min(ry, self.card_h - rh - 6))

                    tile_event = Gtk.EventBox()
                    tile_event.set_size_request(rw, rh)
                    tile_event.get_style_context().add_class("window-tile")
                    tile_event.set_tooltip_text(f"{win['class']}\n{win['title']}")

                    tile_overlay = Gtk.Overlay()

                    tile_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                    tile_box.set_valign(Gtk.Align.CENTER)
                    tile_box.set_halign(Gtk.Align.CENTER)

                    icon_size = 40 if (rw >= 64 and rh >= 64) else 28
                    pixbuf = load_app_pixbuf(win["class"], icon_size)
                    if pixbuf:
                        img = Gtk.Image.new_from_pixbuf(pixbuf)
                        tile_box.pack_start(img, True, True, 0)
                    else:
                        lbl = Gtk.Label(label=win["class"][:5])
                        lbl.get_style_context().add_class("workspace-badge")
                        tile_box.pack_start(lbl, True, True, 0)

                    tile_overlay.add(tile_box)

                    # Close window button on mini-tile
                    close_box = Gtk.EventBox()
                    close_box.set_size_request(16, 16)
                    close_box.get_style_context().add_class("tile-close-btn")
                    close_lbl = Gtk.Label(label="✕")
                    close_lbl.get_style_context().add_class("tile-close-lbl")
                    close_box.add(close_lbl)
                    close_box.set_halign(Gtk.Align.END)
                    close_box.set_valign(Gtk.Align.START)
                    close_box.set_margin_top(3)
                    close_box.set_margin_end(4)
                    close_box.connect("button-press-event", self.on_close_clicked, win["address"])
                    tile_overlay.add_overlay(close_box)

                    tile_event.add(tile_overlay)

                    # DND drag source
                    tile_event.drag_source_set(Gdk.ModifierType.BUTTON1_MASK, dnd_targets, Gdk.DragAction.MOVE)
                    if pixbuf:
                        tile_event.drag_source_set_icon_pixbuf(pixbuf)
                    tile_event.connect("drag-data-get", self.on_drag_data_get, win["address"])
                    tile_event.connect("drag-begin", self.on_drag_begin)
                    tile_event.connect("drag-end", self.on_drag_end)
                    tile_event.connect("button-press-event", self.on_window_clicked, win["address"])

                    fixed.put(tile_event, rx, ry)

                # Window count badge if workspace has >= 3 windows
                if num_wins >= 3:
                    count_lbl = Gtk.Label(label=f"{num_wins} wins")
                    count_lbl.get_style_context().add_class("workspace-count-badge")
                    fixed.put(count_lbl, self.card_w - 56, 8)
            else:
                # Empty workspace: Big elegant centered number
                center_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                center_box.set_size_request(self.card_w, self.card_h)
                center_box.set_valign(Gtk.Align.CENTER)
                center_box.set_halign(Gtk.Align.CENTER)

                num_lbl = Gtk.Label(label=str(ws_id))
                num_lbl.get_style_context().add_class("workspace-empty-num")
                center_box.pack_start(num_lbl, True, True, 0)
                fixed.put(center_box, 0, 0)

            # Direct keyboard shortcut badge (󰘳 1 .. 󰘳 0)
            shortcut_key = "0" if ws_id == 10 else str(ws_id)
            shortcut_badge = Gtk.Label(label=f"󰘳 {shortcut_key}")
            shortcut_badge.get_style_context().add_class("workspace-shortcut-badge")
            fixed.put(shortcut_badge, 8, 8)

            card_event.add(fixed)
            grid.attach(card_event, col, row, 1, 1)

        main_box.pack_start(grid, True, True, 0)
        self.add(main_box)
        self.show_all()

    def on_close_clicked(self, widget, event, address):
        if event.button == 1:
            subprocess.run(["hyprctl", "dispatch", "closewindow", f"address:{address}"])
            GLib.idle_add(self.rebuild_ui)
            return True
        return False

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.dismiss()
            return True
        return False

    def on_drag_begin(self, widget, context):
        self.is_dragging = True

    def on_drag_end(self, widget, context):
        self.is_dragging = False
        if self.pending_dismiss:
            self.dismiss()

    def on_drag_data_get(self, widget, context, data, info, time, address):
        data.set_text(address, -1)

    def on_drag_motion(self, widget, context, x, y, time):
        widget.get_style_context().add_class("drag-hover")
        Gdk.drag_status(context, Gdk.DragAction.MOVE, time)
        return True

    def on_drag_leave(self, widget, context, time):
        widget.get_style_context().remove_class("drag-hover")

    def on_drag_data_received(self, widget, context, x, y, data, info, time, target_ws):
        widget.get_style_context().remove_class("drag-hover")
        address = data.get_text()
        if address and target_ws:
            subprocess.run(["hyprctl", "dispatch", "movetoworkspacesilent", f"{target_ws},address:{address}"])
            # Rebuild overview dynamically to reflect window relocation
            GLib.idle_add(self.rebuild_ui)

    def rebuild_ui(self):
        for child in self.get_children():
            self.remove(child)
        self.build_ui()
        return False

    def on_card_clicked(self, widget, event, ws_id):
        if event.button == 1 and not self.is_dragging:
            subprocess.run(["hyprctl", "dispatch", "workspace", str(ws_id)])
            self.dismiss()

    def on_window_clicked(self, widget, event, address):
        if event.button == 1 and not self.is_dragging:
            subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{address}"])
            self.dismiss()

    def dismiss(self):
        if os.path.exists(PID_FILE):
            try:
                os.remove(PID_FILE)
            except OSError:
                pass
        Gtk.main_quit()

def run_gui():
    win = WorkspaceGridHUD()

    def on_term(signum, frame):
        if win.is_dragging:
            win.pending_dismiss = True
        else:
            win.dismiss()

    signal.signal(signal.SIGTERM, on_term)

    def check_alive():
        if not os.path.exists(PID_FILE) and not win.is_dragging:
            win.dismiss()
            return False
        return True

    GLib.timeout_add(60, check_alive)

    Gtk.main()

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "release":
        cmd_release()
    elif len(sys.argv) > 1 and sys.argv[1] == "gui":
        run_gui()
    else:
        cmd_hold()
