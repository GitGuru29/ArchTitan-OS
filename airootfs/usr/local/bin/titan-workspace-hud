#!/usr/bin/env bash
# Wrapper shim forwarding to unified titan-shell
SHELL_BIN="$(command -v titan-shell 2>/dev/null || echo "/usr/local/bin/titan-shell")"

if [[ "$*" == *"-d"* ]] || [[ "$*" == *"--daemon"* ]]; then
    if ! pgrep -x titan-shell >/dev/null; then
        exec "$SHELL_BIN" --daemon
    fi
    exit 0
fi

if [[ "$*" == *"--show"* ]]; then
    exec "$SHELL_BIN" --show-workspace-hud
elif [[ "$*" == *"--hide"* ]]; then
    exec "$SHELL_BIN" --hide-workspace-hud
elif [[ "$*" == *"--toggle-overview"* ]] || [[ "$*" == *"--overview"* ]]; then
    exec "$SHELL_BIN" --overview
else
    exec "$SHELL_BIN" --workspace-hud
fi
