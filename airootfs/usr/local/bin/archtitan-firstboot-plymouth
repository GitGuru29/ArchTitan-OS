#!/bin/bash
# archtitan-firstboot-plymouth — ArchTitan OS First-Boot Plymouth Switcher
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# "Rise, Titan." is a ONE-SHOT ceremony: it must play only on the very first
# boot after installation.
#
# This service guarantees the one-shot behaviour by:
#   1. refusing to run inside the live ISO (/run/archiso present),
#   2. ensuring first boot is marked done in /var/lib/archtitan/firstboot_done,
#   3. switching plymouthd.conf permanently to 'archtitan' (daily logo theme).

MARKER_DIR="/var/lib/archtitan"
MARKER_FILE="${MARKER_DIR}/firstboot_done"
PLYMOUTH_CONF="/etc/plymouth/plymouthd.conf"

mkdir -p "${MARKER_DIR}"

# Live ISO detection — do not trigger Rise, Titan. on live installer environment
if [ -d /run/archiso ]; then
    exit 0
fi

# If already marked done, ensure daily theme is active and exit
if [ -f "${MARKER_FILE}" ]; then
    if [ -f "${PLYMOUTH_CONF}" ]; then
        sed -i 's/^Theme=.*/Theme=archtitan/' "${PLYMOUTH_CONF}" 2>/dev/null || true
    fi
    exit 0
fi

# First boot: mark done immediately so subsequent boots NEVER run archtitan-rise again
touch "${MARKER_FILE}"

# Set daily theme permanently to 'archtitan'
if [ -f "${PLYMOUTH_CONF}" ]; then
    sed -i 's/^Theme=.*/Theme=archtitan/' "${PLYMOUTH_CONF}" 2>/dev/null || true
fi

# Background initramfs refresh if plymouth helper is available
(
    if command -v plymouth-set-default-theme > /dev/null 2>&1; then
        plymouth-set-default-theme archtitan 2>/dev/null || true
    fi
) &

exit 0
