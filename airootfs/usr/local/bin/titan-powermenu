#!/usr/bin/env bash
# titan-powermenu — Fullscreen Rofi power menu for ArchTitan OS
# Mimics the aesthetic of wlogout natively using rofi-wayland

LOCK="󰌾\nLock"
SLEEP="󰒲\nSleep"
LOGOUT="󰍃\nLogout"
REBOOT="󰑓\nReboot"
SHUTDOWN="󰐥\nShutdown"

if ! command -v rofi >/dev/null 2>&1; then
    exec /usr/local/bin/titan-menu --toggle
fi

THEME="/usr/share/rofi/themes/archtitan-powermenu.rasi"
if [ ! -f "$THEME" ]; then
    THEME="$HOME/.config/rofi/archtitan-powermenu.rasi"
fi

CHOSEN=$(printf '%b\n' "$LOCK" "$SLEEP" "$LOGOUT" "$REBOOT" "$SHUTDOWN" | rofi \
    -dmenu \
    -i \
    -theme "$THEME" 2>/dev/null) || true

case "$CHOSEN" in
    *"Lock"*)
        pidof hyprlock || hyprlock || swaylock -f -c 0b0e14 || loginctl lock-session
        ;;
    *"Sleep"*)
        systemctl suspend -i || loginctl suspend || sudo systemctl suspend -i
        ;;
    *"Logout"*)
        hyprctl dispatch exit || pkill -u "$USER" -x Hyprland || killall -u "$USER" Hyprland || loginctl terminate-session "${XDG_SESSION_ID}" || loginctl terminate-user "$USER"
        ;;
    *"Reboot"*)
        systemctl reboot -i || loginctl reboot || sudo reboot || reboot
        ;;
    *"Shutdown"*)
        systemctl poweroff -i || loginctl poweroff || sudo poweroff || poweroff
        ;;
esac
