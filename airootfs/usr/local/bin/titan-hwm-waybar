#!/usr/bin/env bash
# titan-hwm-waybar — Waybar JSON output for the Titan HWM module
# Reads /run/archtitan/thm-state.json written by the THM v3 daemon.
# Returns: { "text", "class", "tooltip" } for a Waybar custom module.
#
# The daemon is a root system service, so its telemetry lives in /run/archtitan.
# Set THM_TELEMETRY_PATH to override (used by tests).

STATE="${THM_TELEMETRY_PATH:-/run/archtitan/thm-state.json}"

inactive() {
    printf '{"text":"󰒋 THM","class":"inactive","tooltip":"Titan Hardware Manager (THM)\\nDaemon not running\\nNo telemetry at %s\\n\\nClick: Open THM status (or run: titan-hwm help)"}\n' "$STATE"
    exit 0
}

[[ -s "$STATE" ]] || inactive
json=$(cat "$STATE" 2>/dev/null) || inactive
[[ -n "$json" ]] || inactive

# Prefer jq for robust parsing; fall back to a minimal grep/sed extractor.
have_jq=0
command -v jq >/dev/null 2>&1 && have_jq=1

jget() {
    local key="$1" default="$2"
    if (( have_jq )); then
        jq -r "$key // \"$default\"" <<<"$json" 2>/dev/null || echo "$default"
    else
        echo "$default"
    fi
}

level=$(jget '.pressure.level' 'UNKNOWN')
psi=$(jget '.pressure.psi_some_avg10' '0')
mem_used=$(jget '.pressure.mem_used_pct' '0')
governor=$(jget '.governor' '-')
wcount=$(jget '.workload_count' '0')
acount=$(jget '.active_workloads' '0')
action=$(jget '.last_action.decision' 'none')

case "$level" in
    NORMAL)   icon="󰒋";  css_class="normal"   ;;
    MODERATE) icon="󰒋";  css_class="moderate" ;;
    HIGH)     icon="󰒋"; css_class="high"     ;;
    CRITICAL) icon="󰒋"; css_class="critical" ;;
    *)        icon="󰒋";  css_class="inactive" ;;
esac

text="THM ${level}"

tooltip="Titan Hardware Manager (THM) v3\\nPressure: ${level}\\nPSI (10s some): ${psi}%\\nRAM Used: ${mem_used}%\\nCPU Governor: ${governor}\\nWorkloads: ${acount} active / ${wcount} tracked\\nLast action: ${action}\\n\\nClick: View THM status & scan\\nSuper+Shift+H: THM quick view\\nRun: titan-hwm help"

printf '{"text":"%s","class":"%s","tooltip":"%s"}\n' \
    "$text" "$css_class" "$tooltip"
