#!/usr/bin/env bash
# titan-set-wallpaper — Apply and persist a wallpaper via swaybg
#
# Usage: titan-set-wallpaper <path-to-image> [fill|fit|stretch|tile|center|contain]
#
# • Gracefully kills any running swaybg instance first (smooth transition).
# • Launches new swaybg in background.
# • Persists the selection so titan-wallpaper-restore can revive it on next login.
# • Sends a brief notification confirming the change.
#
# Persistence file: ~/.config/archtitan/wallpaper
# (Intentionally NOT inside ~/.config/hypr so hyprpaper doesn't interfere.)

set -euo pipefail

WALLPAPER_PATH="${1:-}"
SCALE_MODE="${2:-fill}"

PERSIST_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/archtitan"
PERSIST_FILE="${PERSIST_DIR}/wallpaper"

# ── Validate ────────────────────────────────────────────────────────────────
if [[ -z "$WALLPAPER_PATH" ]]; then
    echo "Usage: titan-set-wallpaper <path> [fill|fit|stretch|tile|center|contain]" >&2
    exit 1
fi

if [[ ! -f "$WALLPAPER_PATH" ]]; then
    echo "titan-set-wallpaper: file not found: $WALLPAPER_PATH" >&2
    notify-send -u normal -i dialog-error \
        "Wallpaper" "File not found: $(basename "$WALLPAPER_PATH")" 2>/dev/null || true
    exit 1
fi

VALID_MODES="fill fit stretch tile center contain"
if [[ ! " $VALID_MODES " == *" $SCALE_MODE "* ]]; then
    echo "titan-set-wallpaper: invalid mode '$SCALE_MODE'. Valid: $VALID_MODES" >&2
    exit 1
fi

# ── Serialise swaybg handoffs ───────────────────────────────────────────────
# Theme cycling, the TAW daemon and the settings app can all call this at once.
# Without the lock, delayed killers from older invocations can retire the
# newest swaybg and leave a black screen. Holding the lock through the handoff
# means only one process owns swaybg at a time.
LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}"
mkdir -p "$LOCK_DIR"
exec 9>"${LOCK_DIR}/titan-set-wallpaper.lock"
if command -v flock >/dev/null 2>&1; then
    flock -x 9
fi

# ── Launch new swaybg first for seamless overlap ────────────────────────────
# Capture running swaybg PIDs so we only retire them AFTER the new swaybg has
# successfully rendered and presented its layer surface to Wayland.
# This guarantees that the previous wallpaper remains visible until the new one
# takes over, completely eliminating the black screen gap.
OLD_SWAYBG_PIDS=$(pgrep -x swaybg || true)

# Close fd 9 in the child: a long-lived swaybg holding the lock descriptor
# would keep the flock forever and block every later wallpaper change.
swaybg -i "$WALLPAPER_PATH" -m "$SCALE_MODE" 9>&- &
NEW_SWAYBG_PID=$!
disown

# Give the new layer surface time to present before retiring the old ones.
# This happens inside the lock: no later invocation can start another swaybg
# in the meantime, so we can never kill a wallpaper newer than our own.
sleep 0.4
if ! kill -0 "$NEW_SWAYBG_PID" 2>/dev/null; then
    echo "titan-set-wallpaper: swaybg exited early; keeping previous wallpaper" >&2
    exit 1
fi
if [[ -n "$OLD_SWAYBG_PIDS" ]]; then
    for pid in $OLD_SWAYBG_PIDS; do
        if [[ "$pid" != "$NEW_SWAYBG_PID" ]]; then
            kill "$pid" 2>/dev/null || true
        fi
    done
fi

# ── Persist ─────────────────────────────────────────────────────────────────
mkdir -p "$PERSIST_DIR"
printf '%s\n%s\n' "$WALLPAPER_PATH" "$SCALE_MODE" > "${PERSIST_FILE}.tmp.$$"
mv -f "${PERSIST_FILE}.tmp.$$" "$PERSIST_FILE"

# ── Sync active wallpaper into theme.json and TAW config ────────────────────
if [[ -f "${PERSIST_DIR}/theme.json" ]]; then
    python3 -c "
import json, os, sys
p = sys.argv[1]
wp = sys.argv[2]
try:
    with open(p, 'r', encoding='utf-8') as f:
        d = json.load(f)
    if d.get('wallpaper') != wp:
        d['wallpaper'] = wp
        tmp = p + '.tmp.' + str(os.getpid())
        with open(tmp, 'w', encoding='utf-8') as f:
            json.dump(d, f, indent=2, ensure_ascii=False)
            f.write('\n')
        os.replace(tmp, p)
except Exception:
    pass
" "${PERSIST_DIR}/theme.json" "$WALLPAPER_PATH" 2>/dev/null || true
fi

# If setting a user original wallpaper (not an internally generated TAW cache variant), update TAW original
if [[ -z "${TITAN_TAW_KEEP_ORIGINAL:-}" ]] && [[ "$WALLPAPER_PATH" != *"/archtitan/wallpapers/"* ]]; then
    python3 -c "
import json, os, sys
cfg_path = os.path.expanduser('~/.config/archtitan/adaptive-wallpaper.json')
wp = sys.argv[1]
try:
    data = {}
    if os.path.isfile(cfg_path):
        with open(cfg_path, 'r', encoding='utf-8') as f:
            data = json.load(f)
    if data.get('originalWallpaper') != wp:
        data['originalWallpaper'] = wp
        tmp = cfg_path + '.tmp.' + str(os.getpid())
        with open(tmp, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write('\n')
        os.replace(tmp, cfg_path)
except Exception:
    pass
" "$WALLPAPER_PATH" 2>/dev/null || true
fi

# ── Retint the Waybar to suit the new wallpaper ─────────────────────────────
# Best-effort: a theming failure must never fail the wallpaper change.
# Suppressed when TITAN_QUIET is set (`titan-theme set/apply` synchronizes Waybar atomically).
if [[ -z "${TITAN_QUIET:-}" ]]; then
    titan-waybar-theme "$WALLPAPER_PATH" >/dev/null 2>&1 || true
fi

# ── Notify ──────────────────────────────────────────────────────────────────
# TITAN_QUIET=1 suppresses this toast — `titan-theme set` already sends its
# own themed notification and doesn't want a duplicate.
if [[ -z "${TITAN_QUIET:-}" ]]; then
    NAME="$(basename "${WALLPAPER_PATH%.*}")"
    notify-send -u low -i preferences-desktop-wallpaper \
        "Wallpaper applied" "$NAME" 2>/dev/null || true
    snd="/usr/share/sounds/freedesktop/stereo/complete.oga"
    if [[ -f "$snd" ]]; then
        if command -v pw-play >/dev/null 2>&1; then
            pw-play "$snd" >/dev/null 2>&1 9>&- &
        elif command -v paplay >/dev/null 2>&1; then
            paplay "$snd" >/dev/null 2>&1 9>&- &
        fi
    fi
fi
