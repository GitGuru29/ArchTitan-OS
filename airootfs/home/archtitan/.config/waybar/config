{
    "layer"        : "top",
    "position"     : "top",
    "height"       : 38,
    "margin-top"   : 8,
    "margin-left"  : 14,
    "margin-right" : 14,
    "spacing"      : 0,
    "exclusive"    : true,

    "modules-left": [
        "custom/install-badge",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "custom/titan-center"
    ],

    "modules-right": [
        "clock",
        "group/quicksettings",
        "tray",
        "custom/power"
    ],

    // ── LEFT: Workspaces & Installer ───────────────────────────

    "custom/install-badge": {
        "exec"       : "if [ -d /run/archiso ]; then echo '{\"text\": \"󰐥 Install ArchTitan\", \"tooltip\": \"Launch ArchTitan System Installer (Calamares)\"}'; fi",
        "return-type": "json",
        "interval"   : 30,
        "on-click"   : "launch-installer"
    },

    "hyprland/workspaces": {
        "format"              : "{id}",
        "on-click"            : "activate",
        "sort-by-number"      : true,
        "persistent-workspaces": { "*": 5 }
    },

    // ── CENTER: Embedded Rolling Viewport ──────────────────────

    "custom/titan-center": {
        "exec"            : "titan-bar-daemon",
        "return-type"     : "json",
        "restart-interval": 5,
        "on-scroll-down"  : "titan-bar-next",
        "on-scroll-up"    : "titan-bar-prev",
        "on-click"        : "titan-bar-next",
        "on-click-right"  : "titan-bar-prev",
        "tooltip"         : true
    },

    // ── RIGHT: Telemetry & Controls ────────────────────────────

    "clock": {
        "format"         : "󰥔  {:%H:%M}",
        "format-alt"     : "󰃭  {:%a, %b %d}  󰥔  {:%H:%M:%S}",
        "on-click"       : "titan-quicksettings --toggle",
        "tooltip-format" : "<tt><big>{calendar}</big></tt>",
        "calendar": {
            "mode"      : "month",
            "weeks-pos" : "right",
            "on-scroll" : 1,
            "format": {
                "months"  : "<span><b>{}</b></span>",
                "days"    : "<span alpha='75%'>{}</span>",
                "weeks"   : "<span alpha='50%'><b>W{}</b></span>",
                "weekdays": "<span alpha='85%'><b>{}</b></span>",
                "today"   : "<span><b><u>{}</u></b></span>"
            }
        }
    },

    "group/quicksettings": {
        "orientation": "horizontal",
        "modules": [
            "temperature",
            "pulseaudio",
            "network",
            "battery"
        ]
    },

    "temperature": {
        "critical-threshold": 80,
        "format"            : "󰔏 {temperatureC}°C",
        "format-critical"   : "󰔏 {temperatureC}°C",
        "interval"          : 3,
        "on-click"          : "titan-quicksettings --toggle",
        "tooltip"           : false
    },

    "pulseaudio": {
        "format"         : "󰕾 {volume}%",
        "format-muted"   : "󰖁 Muted",
        "on-click"       : "titan-quicksettings --toggle",
        "on-click-right" : "pavucontrol",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up"   : "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down" : "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip"        : false
    },

    "network": {
        "format-wifi"            : "󰤨",
        "format-ethernet"        : "󰈀",
        "format-disconnected"    : "󰤭",
        "interval"               : 5,
        "on-click"               : "titan-quicksettings --toggle",
        "on-click-right"         : "nm-connection-editor",
        "tooltip-format-wifi"    : "{essid} ({signalStrength}%)\nIP: {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}"
    },

    "battery": {
        "states"          : { "good": 95, "warning": 30, "critical": 15 },
        "format"          : "{icon} {capacity}%",
        "format-icons"    : ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "format-charging" : "󰂄 {capacity}%",
        "format-plugged"  : "󰚥 {capacity}%",
        "format-full"     : "󰁹 100%",
        "format-not-found": "",
        "interval"        : 10,
        "on-click"        : "titan-quicksettings --toggle",
        "tooltip-format"  : "{timeTo} · {capacity}%\nPower: {power:.1f}W"
    },

    "tray": {
        "icon-size"        : 14,
        "spacing"          : 8,
        "show-passive-items": true
    },

    "custom/power": {
        "format"        : "⏻",
        "tooltip"       : true,
        "tooltip-format": "Power Menu (Super+Escape / Ctrl+Alt+Del)",
        "on-click"      : "titan-powermenu"
    }
}
